<Page x:Class="Biblioteca.WPF.Views.SociosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Socios" ScrollViewer.CanContentScroll="False">

    <Grid Margin="28,16,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                
            </StackPanel>
            <ui:ProgressRing x:Name="spinner" Grid.Column="1" IsIndeterminate="True"
                             Width="32" Height="32" Visibility="Collapsed" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <ui:Card Grid.Column="0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    

                    <DataGrid x:Name="dgSocios" Grid.Row="1" Style="{StaticResource ModernGrid}"
                              SelectionChanged="dgSocios_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DNI"    Binding="{Binding DNI}"    Width="110" ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="3*"  ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="Email"  Binding="{Binding Email}"  Width="3*"  ElementStyle="{StaticResource TextCell}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="vacios" Grid.Row="1" Style="{StaticResource EmptyState}">
                        
                        <TextBlock Text="No se encontraron socios." Margin="0,8,0,0"
                                   HorizontalAlignment="Center" Style="{StaticResource HintText}" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <Grid Grid.Column="2">
<Grid.RowDefinitions>
<RowDefinition Height="Auto" />
<RowDefinition Height="*" />
</Grid.RowDefinitions>
<Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="txtBuscar" 
                                    PlaceholderText="Buscar por nombre o DNI..."
                                    ClearButtonEnabled="True" TextChanged="txtBuscar_TextChanged" />
                        <ui:Button Grid.Column="1" Margin="8,0,0,0" Padding="10"
                                    ToolTip="Refrescar"
                                   Click="btnRefrescar_Click" />
                    </Grid>
<ui:Card Grid.Row="1" Padding="18">
                <StackPanel>
                    <TextBlock x:Name="lblForm" Text="Nuevo socio"
                               Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />

                    <TextBlock Text="DNI" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox x:Name="txtDNI" PlaceholderText="ej. 12345678" MaxLength="15"
                                CharacterCasing="Upper" />

                    <TextBlock Text="Nombre completo" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox x:Name="txtNombre" PlaceholderText="ej. Ana Torres" MaxLength="100" />

                    <TextBlock Text="Email (opcional)" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox x:Name="txtEmail" PlaceholderText="correo@ejemplo.com"
                                MaxLength="100"  />

                    <UniformGrid Columns="2" Margin="0,20,0,0">
                        <ui:Button Content="Nuevo" 
                                   HorizontalAlignment="Stretch" Margin="0,0,4,0"
                                   Click="btnNuevo_Click" />
                        <ui:Button x:Name="btnGuardar" Content="Guardar"
                                    HorizontalAlignment="Stretch"
                                   Margin="4,0,0,0" Click="btnGuardar_Click" />
                    </UniformGrid>

                    <ui:Button x:Name="btnEliminar" Content="Eliminar socio" Margin="0,8,0,0"
                               HorizontalAlignment="Stretch"
                                IsEnabled="False"
                               Click="btnEliminar_Click" />

                    <TextBlock Margin="0,16,0,0" Style="{StaticResource HintText}"
                               Text="Ctrl+N nuevo · Ctrl+S guardar · Esc cancelar" />
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</Grid>
</Page>







