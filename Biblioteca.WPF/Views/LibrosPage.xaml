<Page x:Class="Biblioteca.WPF.Views.LibrosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Libros" ScrollViewer.CanContentScroll="False">

    <Grid Margin="28,16,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                
            </StackPanel>
            <ui:ProgressRing x:Name="spinner" Grid.Column="1" IsIndeterminate="True"
                             Width="32" Height="32" Visibility="Collapsed" VerticalAlignment="Center" />
        </Grid>

        <!-- Cuerpo: lista + formulario -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Lista -->
            <ui:Card Grid.Column="0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    

                    <DataGrid x:Name="dgLibros" Grid.Row="1" Style="{StaticResource ModernGrid}"
                              SelectionChanged="dgLibros_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ISBN"       Binding="{Binding ISBN}"       Width="140" ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="Titulo"     Binding="{Binding Titulo}"     Width="3*"  ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="Autor"      Binding="{Binding NombreAutor}" Width="2*" ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="Ejemplares" Binding="{Binding Ejemplares}" Width="80"  ElementStyle="{StaticResource NumberCell}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="vacios" Grid.Row="1" Style="{StaticResource EmptyState}">
                        
                        <TextBlock Text="No se encontraron libros." Margin="0,8,0,0"
                                   HorizontalAlignment="Center" Style="{StaticResource HintText}" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <Grid Grid.Column="2">
<Grid.RowDefinitions>
<RowDefinition Height="Auto" />
<RowDefinition Height="*" />
</Grid.RowDefinitions>
<Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="txtBuscar" 
                                    PlaceholderText="Buscar por titulo, ISBN o autor..."
                                    ClearButtonEnabled="True" TextChanged="txtBuscar_TextChanged" />
                        <ui:Button Grid.Column="1" Margin="8,0,0,0" Padding="10"
                                    ToolTip="Refrescar"
                                   Click="btnRefrescar_Click" />
                    </Grid>
<ui:Card Grid.Row="1" Padding="18">
                <StackPanel>
                    <TextBlock x:Name="lblForm" Text="Nuevo libro" Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,14" />

                    <TextBlock Text="ISBN" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox x:Name="txtISBN" PlaceholderText="ej. 978-84-376-0494-7" MaxLength="20" />

                    <TextBlock Text="Titulo" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox x:Name="txtTitulo" PlaceholderText="ej. Cien anos de soledad" MaxLength="200" />

                    <TextBlock Text="Autor" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="cmbAutor" DisplayMemberPath="Nombre"
                              SelectedValuePath="AutorId" HorizontalAlignment="Stretch" />

                    <TextBlock Text="Ejemplares" Style="{StaticResource FieldLabel}" />
                    <ui:NumberBox x:Name="numEjemplares" Value="1" Minimum="1" Maximum="9999"
                                  SpinButtonPlacementMode="Inline" />

                    <UniformGrid Columns="2" Margin="0,20,0,0" >
                        <ui:Button Content="Nuevo" 
                                   HorizontalAlignment="Stretch" Margin="0,0,4,0"
                                   Click="btnNuevo_Click" />
                        <ui:Button x:Name="btnGuardar" Content="Guardar"
                                    HorizontalAlignment="Stretch"
                                   Margin="4,0,0,0" Click="btnGuardar_Click" />
                    </UniformGrid>

                    <ui:Button x:Name="btnEliminar" Content="Eliminar libro" Margin="0,8,0,0"
                               HorizontalAlignment="Stretch"
                                IsEnabled="False"
                               Click="btnEliminar_Click" />

                    <TextBlock Margin="0,16,0,0" Style="{StaticResource HintText}"
                               Text="Ctrl+N nuevo · Ctrl+S guardar · Esc cancelar edicion" />
                </StackPanel>
            </ui:Card></Grid>
        </Grid>
    </Grid>
</Page>




