<ui:FluentWindow x:Class="Biblioteca.WPF.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:Biblioteca.WPF.Views"
                 Title="Biblioteca" Width="1360" Height="840" MinWidth="1100" MinHeight="700"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round">
    <Grid Background="#0F3818">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Garcia · Biblioteca"
                     >
            <ui:TitleBar.TrailingContent>
                <ui:Button x:Name="btnTema" Appearance="Transparent" BorderThickness="0"
                           Padding="10,6" Margin="0,0,8,0" ToolTip="Cambiar tema"
                            Click="btnTema_Click" />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <ui:NavigationView x:Name="NavPrincipal" Grid.Row="1"
                           PaneDisplayMode="Top" OpenPaneLength="210"
                           IsBackButtonVisible="Collapsed" IsPaneToggleVisible="False" TransitionDuration="0">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Libros"    
                                       TargetPageType="{x:Type views:LibrosPage}" />
                <ui:NavigationViewItem Content="Socios"    
                                       TargetPageType="{x:Type views:SociosPage}" />
                <ui:NavigationViewItem Content="Prestamos" 
                                       TargetPageType="{x:Type views:PrestamosPage}" />
                <ui:NavigationViewItem Content="Reportes"  
                                       TargetPageType="{x:Type views:ReportesPage}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <ui:ContentDialogHost x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>






