<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="BibliotecaDB"
         connectionString="Server=GENESIS\SQLEXPRESS;Database=BibliotecaDB;Trusted_Connection=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="MaxPrestamosPorSocio" value="3" />
    <add key="DiasPrestamo"         value="15" />
  </appSettings>
</configuration>

